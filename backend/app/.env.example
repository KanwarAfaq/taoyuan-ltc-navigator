# Get these from Supabase: Project Settings -> API
# SUPABASE_URL looks like: https://imtbpcqogiqbzlbmyzqk.supabase.co
# SUPABASE_KEY is the "anon public" key (safe for this use case — the
# facilities table only allows public SELECT via RLS, see schema.sql)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# service_role key -- ONLY needed for the facility vacancy self-update
# feature (admin_router.py), which is the one part of this backend that
# writes to the database. Project Settings -> API -> service_role secret.
# Keep this very private -- it bypasses your RLS policy entirely.
SUPABASE_SERVICE_KEY=your-service-role-key

# From LINE Developers Console -> your Messaging API channel
#   LINE_CHANNEL_SECRET: Basic settings tab -> Channel secret
#   LINE_CHANNEL_ACCESS_TOKEN: Messaging API tab -> Channel access token (issue one if you haven't)
LINE_CHANNEL_SECRET=your-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
