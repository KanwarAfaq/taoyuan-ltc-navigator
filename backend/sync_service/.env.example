# Project Settings -> API in Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key (NOT anon) -- this service needs write access.
# Project Settings -> API -> service_role secret. Keep this very private.
SUPABASE_KEY=your-service-role-key

# Get a free key at https://opencagedata.com/api (2,500 req/day)
OPENCAGE_API_KEY=your-opencage-key

# Make up a long random string yourself -- this protects the /sync
# endpoint from random internet traffic triggering it. You'll paste this
# same value into cron-job.org's URL as a query param.
SYNC_SECRET_TOKEN=change-this-to-something-long-and-random
